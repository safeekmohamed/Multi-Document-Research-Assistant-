# Primary local LLM provider. No cloud LLM API key is required for Ollama.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=30m
RAG_MODEL_WARMUP_ON_STARTUP=true
HF_HUB_ETAG_TIMEOUT=10
HF_HUB_DOWNLOAD_TIMEOUT=180

# Optional cloud providers (select explicitly with LLM_PROVIDER=gemini or groq).
# GEMINI_API_KEY=your_google_ai_studio_api_key
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=your_groq_model
