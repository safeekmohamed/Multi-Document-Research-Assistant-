# Primary local LLM provider. No cloud LLM API key is required for Ollama.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=30m
# Set false on small Render instances to avoid loading the embedding model at startup.
RAG_MODEL_WARMUP_ON_STARTUP=true
HF_HUB_ETAG_TIMEOUT=10
HF_HUB_DOWNLOAD_TIMEOUT=180

# Bounded per-request retrieval budgets. Defaults keep lexical scanning and
# reranking manageable on small instances; higher values trade memory for recall.
RAG_SEMANTIC_CANDIDATE_LIMIT=80
RAG_LEXICAL_CHUNK_LIMIT=500
RAG_RERANK_MAX_CANDIDATES=48
# Reranking is disabled by default on Render (RENDER=true) to avoid retaining
# a second transformer model beside the embedding model on 512 MB instances.
# Set true on larger instances; local development remains enabled by default.
# RAG_RERANKER_ENABLED=true

# Optional cloud providers (select explicitly with LLM_PROVIDER=gemini or groq).
# GEMINI_API_KEY=your_google_ai_studio_api_key
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=your_groq_model
